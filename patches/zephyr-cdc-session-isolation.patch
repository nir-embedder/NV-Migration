+#define ZEPHYR_INCLUDE_USB_CLASS_USBD_CDC_ACM_H_
+
+#include <zephyr/device.h>
+
+/** Session boundary notification, invoked on the CDC workqueue without locks.
+ * Driver FIFOs are empty and admission is closed. Request application protocol
+ * reset here; do not wait for work on the same queue. Includes initial enable,
+ * explicit DTR clear and configuration disable. Multiple closes may coalesce.
+ */
+typedef void (*usbd_cdc_acm_session_cb_t)(const struct device *dev, void *user_data);
+
+/** Register before USB enable. NULL removes the callback. Returns -ENODEV for
+ * a device which is not the next-stack CDC ACM UART implementation.
+ */
+int usbd_cdc_acm_set_session_cb(const struct device *dev,
+                              usbd_cdc_acm_session_cb_t cb, void *user_data);
+
+#endif
